# Copy to .env (bun loads it) — or set these in the compose .env.
PORT=3000
DATA_DIR=./data
# The one secret. Paste the same string into the app's Settings → Server.
MURMUR_TOKEN=change-me
# Extra yt-dlp flags, e.g. a proxy or `--js-runtimes node`.
YTDLP_ARGS=
# A Netscape cookies file gets a datacenter IP past YouTube's bot check.
# Defaults to $DATA_DIR/cookies.txt if that file exists.
# YTDLP_COOKIES=/data/cookies.txt
# Where clients reach this server; goes into the pairing QR printed at startup.
PUBLIC_URL=
SERVER_NAME=Server
DOWNLOAD_CONCURRENCY=1
