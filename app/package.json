{
	"name": "@murmur/app",
	"version": "0.1.0",
	"main": "index.js",
	"private": true,
	"scripts": {
		"dev": "bun run --cwd .. dev",
		"start": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 expo start",
		"android": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 expo run:android",
		"web": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 expo start --web",
		"export:web": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 expo export --platform web",
		"export:android": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 expo export --platform android",
		"prebuild": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 expo prebuild --platform android",
		"build:dev": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 eas build --profile development --platform android",
		"doctor": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 expo install --check",
		"brand": "node scripts/brand.mjs"
	},
