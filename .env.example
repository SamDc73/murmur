# docker compose reads this as .env
# A public name gets HTTPS by itself. On a home network with no DNS name, use
# DOMAIN=:80 (plain HTTP on port 80) and set PUBLIC_URL to http://<this box's address>.
DOMAIN=murmur.example.com
MURMUR_TOKEN=change-me-to-something-long
SERVER_NAME=Home
# The pairing QR in the server log points here; defaults to https://$DOMAIN
PUBLIC_URL=
# Extra yt-dlp flags, e.g. --proxy socks5://… (cookies: put cookies.txt in the data volume)
YTDLP_ARGS=
# Pin a build instead of following main: a commit's short SHA, e.g. MURMUR_TAG=sha-1a2b3c4
MURMUR_TAG=
